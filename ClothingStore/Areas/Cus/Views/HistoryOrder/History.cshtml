@model IEnumerable<ClothingStore.Models.Order>

@{
    ViewData["Title"] = "Lịch sử đơn hàng";
}

<h2 class="text-center">Lịch Sử Đơn Hàng</h2>

@if (!Model.Any())
{
    <p class="text-center text-muted">Bạn chưa có đơn hàng nào.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>#</th>
                <th>Ngày Đặt</th>
                <th>Địa Chỉ</th>
                <th>Tổng Tiền</th>
                <th>Trạng Thái</th>
                <th>Chi Tiết</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.IdOrder</td>
                    <td>@order.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@order.DiaChi</td>
                    <td>@order.TongTien.ToString("N0") đ</td>
                    <td>
                        <span class="badge @(order.StatusOrder == "Chờ xác nhận" ? "bg-warning" : "bg-success")">
                            @order.StatusOrder
                        </span>
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@order.IdOrder" class="btn btn-info btn-sm">Xem</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
