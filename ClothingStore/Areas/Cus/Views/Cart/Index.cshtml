@model Cart

@{
    ViewData["Title"] = "Giỏ Hàng";
}

<div class="container mt-4">
    <h2 class="text-center mb-4">🛒 Giỏ Hàng Của Bạn</h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }

    @if (Model != null && Model.Items.Count > 0)
    {
        <table class="table table-hover text-center align-middle">
            <thead class="table-dark">
                <tr>
                    <th><input type="checkbox" id="selectAll"></th>
                    <th>Hình ảnh</th>
                    <th>Tên sản phẩm</th>
                    <th>Giá</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <input type="checkbox" class="product-checkbox" data-id="@item.ProductId" data-price="@item.Price" checked>
                        </td>
                        <td>
                            <img src="@item.ImageUrl" width="70" class="img-thumbnail rounded">
                        </td>
                        <td>@item.ProductName</td>
                        <td>@item.Price.ToString("N0") VND</td>
                        <td>
                            <input type="number" class="form-control text-center quantity-input" data-id="@item.ProductId"
                                   value="@item.Quantity" min="1" style="width: 70px;">
                        </td>
                        <td class="total-price" data-id="@item.ProductId">@((item.Price * item.Quantity).ToString("N0")) VND</td>
                        <td>
                            <a href="@Url.Action("RemoveFromCart", "Cart", new { productId = item.ProductId })"
                               class="btn btn-danger btn-sm">
                                ❌ Xóa
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex justify-content-between align-items-center">
            <h4 class="fw-bold">🛍️ Tổng tiền: <span id="totalCartPrice">@ViewBag.TotalPrice.ToString("N0")</span> VND</h4>
            <button id="checkoutBtn" class="btn btn-success btn-lg">✅ Đặt hàng</button>
        </div>
    }
    else
    {
        <p class="text-center text-muted">🛒 Giỏ hàng của bạn đang trống!</p>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            function updateTotalPrice() {
                let total = 0;
                $(".product-checkbox:checked").each(function () {
                    let productId = $(this).data("id");
                    let price = $(this).data("price");
                    let quantity = $(`.quantity-input[data-id='${productId}']`).val();
                    total += price * quantity;
                });
                $("#totalCartPrice").text(total.toLocaleString() + " VND");
            }

            $(".quantity-input").on("change", function () {
                let productId = $(this).data("id");
                let newQuantity = $(this).val();

                $.ajax({
                    url: '@Url.Action("UpdateQuantity", "Cart")',
                    type: "POST",
                    data: { productId: productId, quantity: newQuantity },
                    success: function (response) {
                        if (response.success) {
                            $(`.total-price[data-id='${productId}']`).text(response.newTotalPrice + " VND");
                            updateTotalPrice();
                        }
                    }
                });
            });

            $(".product-checkbox").on("change", function () {
                updateTotalPrice();
            });

            $("#selectAll").on("change", function () {
                $(".product-checkbox").prop("checked", $(this).prop("checked"));
                updateTotalPrice();
            });

            $("#checkoutBtn").on("click", function () {
                let selectedProducts = [];
                $(".product-checkbox:checked").each(function () {
                    selectedProducts.push($(this).data("id"));
                });

                if (selectedProducts.length === 0) {
                    alert("Vui lòng chọn ít nhất một sản phẩm để đặt hàng!");
                    return;
                }

                $.ajax({
                    url: '@Url.Action("Checkout", "Cart")',
                    type: "POST",
                    data: { selectedProducts: selectedProducts },
                    xhrFields: { withCredentials: true },
                    success: function (response) {
                        if (response.success) {
                            window.location.href = '@Url.Action("ConfirmOrder", "Order", new { area = "Cus" })';
                        }
                    }
                });
            });

            updateTotalPrice();
        });
    </script>
}
