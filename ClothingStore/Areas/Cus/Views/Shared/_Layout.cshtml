@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - My ASP.NET Application</title>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <link rel="stylesheet" href="~/css/styleHeader.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">


    <style>
        /*footer*/
/* Footer tổng thể */
.footer {
    background-color: black;
    color: white;
    padding: 40px 0;
    display: flex;
    justify-content: center;
}

/* Bố cục nội dung */
.nd {
    width: 90%;
    max-width: 1200px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 30px;
}

/* Các cột trong footer */
.thu1, .thu2, .thu3, .thu4 {
    flex: 1;
    min-width: 250px;
    max-width: 300px;
}

/* Tiêu đề */
.thu1 h1, .thu3 h1, .thu4 h3, .thu2 h1 {
    color: #bfbfbf;
    font-size: 20px;
    margin-bottom: 15px;
}

/* Chữ nội dung */
.footer p {
    text-align: left;
    color: #d9d9d9;
    font-size: 14px;
    line-height: 1.6;
    margin-bottom: 10px;
}

/* Ảnh logo bộ công thương */
.lazyloaded {
    height: 50px;
    width: auto;
    margin-top: 10px;
}

/* Danh sách hỗ trợ khách hàng */
.hotro {
    list-style: none;
    padding: 0;
}

.hotro li {
    margin-bottom: 8px;
}

.hotro a {
    color: white;
    text-decoration: none;
    transition: color 0.3s ease;
}

.hotro a:hover {
                    color: white;
}

/* Chăm sóc khách hàng */
.thu4 h4 {
            color: white;
    font-size: 22px;
    margin-bottom: 5px;
}

.thu4 a {
            color: white;
    font-size: 15px;
    text-decoration: none;
}

.thu4 a:hover {
    text-decoration: underline;
}



        /*footer*/
        li.format-hello{
            padding-top:15px;
            color:white;
        }


        /* Đảm bảo header luôn nằm trên cùng */
        .navbar {
            z-index: 1000; /* Đặt z-index cao để đảm bảo header hiển thị trên nội dung */
        }

        /* Đảm bảo nội dung không bị header che mất */
        .body-content {
            padding-top: 60px; /* Tăng giá trị nếu header cao hơn */
        }

        .navbar-nav {
            display: flex;
            align-items: center; /* Giúp các mục trong navbar thẳng hàng */
        }

            /* Căn chỉnh giỏ hàng, tài khoản, ngôn ngữ đẹp hơn */
            .navbar-nav li {
                padding: 10px 15px; /* Giãn cách đều giữa các mục */
            }

        .navbar-form {
            margin-top: 10px; /* Căn chỉnh form tìm kiếm */
        }

        /* Căn chỉnh icon giỏ hàng */
        .navbar-nav .badge {
            position: absolute;
            top: 10px;
            right: 10px;
        }

        .page-title {
            font-size: 24px;
            font-weight: bold;
            margin-top: 20px; /* Tạo khoảng cách phía trên */
            text-align: left; /* Căn lề trái */
        }

        /*Đăng nhập đăng xuất*/
        .user-menu {
            position: relative;
            display: inline-block;
        }

        .dropdown-menu {
            display: none;
            position: absolute;
            background: white;
            list-style: none;
            padding: 0;
            border: 1px solid #ccc;
            width: 120px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
        }

            .dropdown-menu li {
                padding: 10px;
                cursor: pointer;
            }

                .dropdown-menu li a {
                    text-decoration: none;
                    color: black;
                    display: flex;
                    align-items: center;
                }

                    .dropdown-menu li a i {
                        margin-right: 8px;
                    }

        .user-menu:hover .dropdown-menu {
            display: block;
        }

    </style>

</head>
<body>
    <header class="header">
        <div class="container d-flex align-items-center justify-content-between">
            <!-- Logo -->
            <div class="logo">
                <img src="https://file.hstatic.net/1000281824/file/artboard_1_d0b1ee0551c34aa0b846e62d14a33666.png" alt="Logo">
            </div>

            <!-- Menu -->
            <nav class="nav">
                <ul class="nav-list d-flex">
                    <li><a asp-controller="Home" asp-action="Index" asp-area="Cus">Trang chủ</a></li>
                    <li><a asp-controller="Product" asp-action="Index" asp-area="Cus">Sản phẩm</a></li>
                    <li><a asp-controller="Home" asp-action="Store" asp-area="Cus">Cửa hàng</a></li>
                    <li><a asp-controller="HistoryOrder" asp-action="History" asp-area="Cus">Kiểm tra đơn hàng</a></li>
                    <li><a asp-controller="Home" asp-action="Gioithieu" asp-area="Cus">Giới thiệu</a></li>
                </ul>
            </nav>

            <!-- Search, Cart, Language -->
            <div class="header-right d-flex align-items-center">
                <div class="search-box">
                    <input type="text" class="form-control" placeholder="Tìm kiếm sản phẩm...">
                    <i class="fas fa-search"></i>
                </div>

                <a asp-controller="Cart" asp-action="Index" asp-area="Cus" class="cart" style="text-decoration: none;color: inherit;display: flex">
                <div class="cart">
                    <i class="fas fa-shopping-cart"></i>
                    <span class="cart-count">0</span>
                    <span class="cart-text">Giỏ hàng</span>
                </div>
                </a>

                <!-- Language Selector -->
                <div class="user-menu">
                    <button class="btn dropdown-toggle" id="userBtn">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/b/bb/Flag_of_Vietnam.png" alt="User">
                    </button>
                    <ul class="dropdown-menu" id="userMenu">
                        
                        <li>
                            <a asp-controller="Account" asp-action="Profile" asp-area="Cus" >
                                <i class="fas fa-user"></i> Trang cá nhân
                            </a>
                        </li>
                        <li><a asp-controller="Auth" asp-action="Login" asp-area="Cus"><i class="fas fa-sign-in-alt"></i> Đăng nhập</a></li>
                        <li><a asp-controller="Auth" asp-action="Logout" asp-area="Cus"><i class="fas fa-sign-out-alt"></i> Đăng xuất</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </header>
    <div class="container body-content">
        @RenderBody()
        <hr />

    </div>
    <footer>
        <div class="footer">
            <div class="nd">
                <div class="thu1">
                    <h1>Về Degrey</h1>
                    <p>
                        Cái tên Degrey được tạo ra rất ngẫu hứng, xuất phát từ “Chuỗi ngày u buồn về sự nghiệp, tương lai trong quá khứ của chính mình” – theo lời chia sẻ của Degrey’s founder.
                    </p>
                    <p>
                        <b>CÔNG TY TNHH DEGREY</b><br>
                        "0315986019 cấp ngày 31/10/2019 tại Sở kế hoạch đầu tư TPHCM"
                    </p>
                    <a href="http://online.gov.vn/Home/WebDetails/104783" rel="noreferrer">
                        <img class="lazyloaded" src="https://file.hstatic.net/1000281824/file/dathongbao_22c990fc936b40e0a50a1b646f478284.png" alt="Bộ Công Thương">
                    </a>
                </div>
                <div class="thu2">
                    <h1>Địa chỉ</h1>
                    <p>
                        <b>Sài Gòn:</b><br>
                        43 Huỳnh Văn Bánh, P.17, Q.Phú Nhuận<br>
                        1041 Luỹ Bán Bích, P.Tân Thành, Q.Tân Phú
                    </p>
                    <p>📞 0932152301</p>
                    <p>📧 <a href="mailto:degrey.vn@gmail.com">degrey.vn@gmail.com</a></p>
                </div>

                <div class="thu3">
                    <h1>Hỗ trợ khách hàng</h1>
                    <ul class="hotro">
                        <li><a href="~/Home/GioiThieu">Giới Thiệu Degrey</a></li>
                        <li><a href="~/Home/Store">Hệ Thống Cửa Hàng</a></li>
                        <li><a href="">Hướng Dẫn Đặt Hàng</a></li>
                        <li><a href="">Chính sách và quy định</a></li>
                        <li><a href="">Chính sách bảo mật</a></li>
                        <li><a href="">Thông Tin Sở Hữu</a></li>
                    </ul>
                </div>

                <div class="thu4">
                    <h3>Chăm sóc khách hàng</h3>
                    <h4>0336 311 117</h4>
                    <p>📧 <a href="mailto:degrey.vn@gmail.com">degrey.vn@gmail.com</a></p>
                    <h3>Follow Us</h3>
                </div>
            </div>
        </div>
    </footer>



    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
