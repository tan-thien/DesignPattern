@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập";
}

<div class="login-container">
    <h2 class="login-title">Đăng nhập</h2>

    @if (ViewData["ErrorMessage"] != null)
    {
        <div class="error-message">@ViewData["ErrorMessage"]</div>
    }

    <form asp-area="Cus" asp-controller="Auth" asp-action="Login" method="post" class="login-form">
        <div class="form-group">
            <label for="username">Tên đăng nhập:</label>
            <input type="text" id="username" name="username" class="form-control" placeholder="Nhập tên đăng nhập" required />
        </div>
        <div class="form-group">
            <label for="password">Mật khẩu:</label>
            <input type="password" id="password" name="password" class="form-control" placeholder="Nhập mật khẩu" required />
        </div>
        <button type="submit" class="submit-button">Đăng nhập</button>

        <div class="text-center mt-3">
            <p>
                Chưa có tài khoản?
                <a asp-area="Cus" asp-controller="Account" asp-action="Register" class="text-decoration-none">Đăng ký ngay</a>
            </p>
        </div>

    </form>
</div>

<style>
    .login-container {
        width: 100%;
        max-width: 400px;
        margin: 50px auto;
        padding: 20px;
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    }

    .login-title {
        text-align: center;
        margin-bottom: 20px;
        font-size: 24px;
        font-weight: bold;
    }

    .error-message {
        color: red;
        text-align: center;
        margin-bottom: 15px;
    }

    .form-group {
        margin-bottom: 15px;
    }

    label {
        display: block;
        margin-bottom: 5px;
        font-weight: 600;
    }

    .form-control {
        width: 100%;
        padding: 10px;
        font-size: 16px;
        border: 1px solid #ddd;
        border-radius: 5px;
    }

    .submit-button {
        width: 100%;
        padding: 10px;
        font-size: 18px;
        color: #fff;
        background-color: #007bff;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        transition: background-color 0.3s;
    }

        .submit-button:hover {
            background-color: #0056b3;
        }
</style>
