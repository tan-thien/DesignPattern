@model ClothingStore.Models.User

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg p-4">
                <h2 class="text-center text-primary mb-4">Đăng ký tài khoản</h2>

                <form asp-action="Register" method="post">
                    <div class="mb-3">
                        <label class="form-label"><i class="fas fa-user"></i> Tên đăng nhập</label>
                        <input asp-for="UserName" class="form-control" placeholder="Nhập tên đăng nhập" required />
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label"><i class="fas fa-lock"></i> Mật khẩu</label>
                        <input asp-for="PassWord" type="password" class="form-control" placeholder="Nhập mật khẩu" required />
                        <span asp-validation-for="PassWord" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-user-plus"></i> Đăng ký
                    </button>
                </form>

                <div class="text-center mt-3">
                    <p>Đã có tài khoản? <a asp-area="Cus" asp-controller="Auth" asp-action="Login" class="text-decoration-none">Đăng nhập ngay</a></p>
                </div>
            </div>
        </div>
    </div>
</div>
